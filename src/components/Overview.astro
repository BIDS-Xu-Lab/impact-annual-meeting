---
import { event } from "../data/agenda";
import { locations, kindLabel, directionsUrl } from "../data/locations";
---

<section id="overview" class="section section-a">
  <div class="container">
    <div class="reveal">
      <span class="section-tag">About the Event</span>
      <h2 class="section-title">Overview</h2>
    </div>

    <div class="overview-grid">
      <article class="overview-card reveal">
        <h3>About</h3>
        <p>Join us for the annual IMPACT-MH Consortium Meeting hosted by our parters at NIH.</p>
        <p class="overview-muted">
          This year, we'll be meeting in-person at the NIH headquarters in Maryland, and offering a remote participation option.
          All consortium members are invited and welcome to attend. More details to follow as they develop.
        </p>
      </article>

      <article class="overview-card reveal">
        <h3>Date &amp; Location</h3>
        <dl class="overview-facts">
          <div class="overview-fact">
            <dt>Date</dt>
            <dd>{event.dates}</dd>
          </div>
          <div class="overview-fact">
            <dt>Location</dt>
            <dd>{event.venue}</dd>
          </div>
        </dl>
      </article>
    </div>

    <div class="map-card reveal">
      <div class="map-header">
        <h3>Map &amp; Directions</h3>
        <p class="map-sub">
          The reception venue and both hotel options are within a short walk of the
          conference building.
        </p>
      </div>

      <div
        id="venue-map"
        class="map-embed"
        role="img"
        aria-label="Map of the conference venue at 6001 Executive Blvd and three nearby locations: Pinstripes, Canopy by Hilton, and the Bethesda North Marriott. Each location is also listed below the map."
      >
      </div>

      <ul class="map-legend">
        {
          locations.map((loc) => (
            <li class:list={["map-legend-item", `map-legend-${loc.kind}`]}>
              <span class="map-legend-dot" aria-hidden="true" />
              <div class="map-legend-body">
                <span class="map-legend-role">{kindLabel[loc.kind]}</span>
                <span class="map-legend-name">{loc.name}</span>
                <span class="map-legend-address">{loc.address}</span>
                <a
                  class="map-legend-link"
                  href={directionsUrl(loc)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Directions &rarr;
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .overview-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .overview-card {
    position: relative;
    overflow: hidden;
    padding: 2.25rem 2.25rem 2.5rem;
    background: var(--surface-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .overview-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .overview-card h3 {
    font-size: 1.45rem;
    margin-bottom: 0.9rem;
  }

  .overview-card p + p {
    margin-top: 0.75rem;
  }

  .overview-muted {
    color: var(--text-muted);
    font-size: 1.0rem;
  }

  .overview-facts {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .overview-fact {
    padding-left: 1rem;
    border-left: 3px solid var(--blue);
  }

  .overview-fact dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .overview-fact dd {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-heading);
  }

  .map-card {
    margin-top: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    background: var(--surface-card);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .map-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  .map-header {
    padding: 2.25rem 2.25rem 1.5rem;
  }

  .map-header h3 {
    font-size: 1.45rem;
  }

  .map-sub {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .map-embed {
    height: 380px;
    background: var(--section-a);
  }

  .map-legend {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 2rem;
    padding: 1.75rem 2.25rem 2.25rem;
    list-style: none;
    border-top: 1px solid var(--border-light);
  }

  .map-legend-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .map-legend-dot {
    width: 12px;
    height: 12px;
    margin-top: 0.45rem;
    border-radius: 50%;
    border: 2px solid var(--navy-ink);
    flex-shrink: 0;
  }

  .map-legend-venue .map-legend-dot {
    background: var(--pink);
  }

  .map-legend-reception .map-legend-dot {
    background: var(--mint);
  }

  .map-legend-hotel .map-legend-dot {
    background: var(--blue);
  }

  .map-legend-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .map-legend-role {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .map-legend-name {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-heading);
  }

  .map-legend-address {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .map-legend-link {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--navy);
  }

  .map-legend-link:hover {
    color: var(--pink);
  }

  @media (max-width: 768px) {
    .overview-grid {
      grid-template-columns: 1fr;
    }

    .map-embed {
      height: 320px;
    }

    .map-legend {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }

    .map-header {
      padding: 1.75rem 1.5rem 1.25rem;
    }
  }
</style>

<style is:global>
  /* Leaflet injects markers, popups and controls at runtime, so these nodes never
     receive Astro's scoping attribute and must be styled globally. */
  .map-pin {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2.5px solid var(--navy-ink);
    box-shadow: 0 2px 6px rgba(0, 28, 57, 0.4);
  }

  .map-pin-venue {
    width: 26px;
    height: 26px;
    background: var(--pink);
    border-width: 3px;
    box-shadow:
      0 0 0 5px rgba(235, 112, 154, 0.25),
      0 2px 8px rgba(0, 28, 57, 0.45);
  }

  .map-pin-reception {
    background: var(--mint);
  }

  .map-pin-hotel {
    background: var(--blue);
  }

  .leaflet-container {
    font-family: var(--font-body);
  }

  .leaflet-popup-content-wrapper {
    border-radius: 12px;
    box-shadow: var(--shadow-card-hover);
  }

  .leaflet-popup-content {
    margin: 0.9rem 1.1rem;
    line-height: 1.45;
  }

  .map-popup-role {
    display: block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .map-popup-name {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-heading);
  }

  .map-popup-address {
    display: block;
    margin-top: 0.2rem;
    color: var(--text-muted);
  }

  .map-popup-note {
    display: block;
    margin-top: 0.35rem;
    font-style: italic;
    color: var(--text-muted);
  }

  .map-popup-link {
    display: inline-block;
    margin-top: 0.6rem;
    font-weight: 600;
    color: var(--navy);
  }
</style>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";
  import { locations, kindLabel, directionsUrl } from "../data/locations";

  const container = document.getElementById("venue-map");

  if (container) {
    const map = L.map(container, { scrollWheelZoom: false });

    L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", {
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: "abcd",
      maxZoom: 19,
    }).addTo(map);

    for (const loc of locations) {
      const icon = L.divIcon({
        className: "",
        html: `<div class="map-pin map-pin-${loc.kind}"></div>`,
        iconSize: loc.kind === "venue" ? [26, 26] : [18, 18],
        iconAnchor: loc.kind === "venue" ? [13, 13] : [9, 9],
        popupAnchor: [0, loc.kind === "venue" ? -14 : -10],
      });

      L.marker([loc.lat, loc.lng], { icon, title: loc.name, alt: loc.name })
        .addTo(map)
        .bindPopup(
          `<span class="map-popup-role">${kindLabel[loc.kind]}</span>
           <span class="map-popup-name">${loc.name}</span>
           <span class="map-popup-address">${loc.address}</span>
           ${loc.note ? `<span class="map-popup-note">${loc.note}</span>` : ""}
           <a class="map-popup-link" href="${directionsUrl(loc)}" target="_blank" rel="noopener noreferrer">Directions &rarr;</a>`
        );
    }

    map.fitBounds(L.latLngBounds(locations.map((loc) => [loc.lat, loc.lng])), {
      padding: [48, 48],
    });
  }
</script>
