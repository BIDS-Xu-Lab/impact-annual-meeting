---
import Button from "./Button.astro";
import { agenda, event } from "../data/agenda";
---

<section id="agenda" class="section section-b">
  <div class="container">
    <div class="reveal">
      <span class="section-tag">Agenda · Tentative</span>
      <h2 class="section-title">Registration &amp; Agenda</h2>
      <p class="section-lead">
        The full two-day program is below. Day 2 breakout topics and their order are
        still being finalized and may change.
      </p>
    </div>

    <aside class="registration-notice reveal">
      <p>
        <strong>Registration is open through {event.registrationCloses}.</strong> Questions about
        attending? Reach out to Polly Painter (<a href="mailto:polly.painter@yale.edu"
          >polly.painter@yale.edu</a
        >).
      </p>
      <div class="registration-actions">
        <Button href={event.registerUrl} size="lg" newTab>Register Now</Button>
        <Button href={event.checkRegistrationUrl} variant="ghost" size="lg" newTab
          >Check Registration</Button
        >
      </div>
    </aside>

    <div class="agenda-days">
      {
        agenda.map((day) => (
          <article class="agenda-day reveal" id={day.id}>
            <header class="agenda-day-header">
              <span class="agenda-day-label">{day.label}</span>
              <h3>{day.date}</h3>
            </header>

            {day.note && <p class="agenda-day-note">{day.note}</p>}

            <ul class="agenda-items">
              {day.items.map((item) => (
                <li class:list={["agenda-item", item.kind && `agenda-item-${item.kind}`]}>
                  <span class="agenda-time">{item.time}</span>
                  <div class="agenda-content">
                    <h4>{item.title}</h4>
                    {item.note && <p class="agenda-note">{item.note}</p>}

                    {item.bullets && (
                      <ul class="agenda-bullets">
                        {item.bullets.map((bullet) => (
                          <li>{bullet}</li>
                        ))}
                      </ul>
                    )}

                    {item.presentations && (
                      <div class="agenda-detail">
                        <span class="agenda-detail-label">Presentation order</span>
                        <ol class="presentation-order">
                          {item.presentations.map((presentation, index) => (
                            <li class="presentation-row">
                              <span class="presentation-num">{index + 1}</span>
                              <span class="presentation-site">{presentation.site}</span>
                              <span class="presentation-org">{presentation.org}</span>
                            </li>
                          ))}
                        </ol>
                        {/* prettier-ignore */}
                        <a class="agenda-jump" href="#presentations">What each presentation covers ↓</a>
                      </div>
                    )}

                    {item.breakouts && (
                      <div class="agenda-detail">
                        <span class="agenda-detail-label">Concurrent tracks</span>
                        <ul class="breakout-tracks">
                          {item.breakouts.map((breakout) => (
                            <li class="breakout-track">
                              <span class="breakout-code">{breakout.code}</span>
                              <h5 class="breakout-title">{breakout.title}</h5>
                              {breakout.detail && (
                                <p class="breakout-detail">{breakout.detail}</p>
                              )}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .registration-notice {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    margin-top: 1.75rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--pink);
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
  }

  .registration-notice p {
    font-size: 1.05rem;
    color: var(--text-heading);
  }

  .registration-notice a:not(.btn) {
    color: var(--navy);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .registration-notice a:not(.btn):hover {
    color: var(--pink);
  }

  .registration-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* .btn-ghost is tuned for dark surfaces (global.css); override for this light card */
  .registration-actions :global(.btn-ghost) {
    background: transparent;
    border-color: var(--border-light);
    color: var(--navy);
  }

  .registration-actions :global(.btn-ghost:hover) {
    border-color: var(--blue);
    color: var(--blue);
    background: rgba(99, 170, 255, 0.08);
  }

  .agenda-days {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  .agenda-day {
    background: var(--surface-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .agenda-day-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 2rem;
    background: linear-gradient(120deg, var(--navy-ink), var(--navy));
  }

  .agenda-day-label {
    padding: 0.3rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(99, 170, 255, 0.18);
    border: 1px solid rgba(99, 170, 255, 0.35);
    color: var(--blue-pale);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .agenda-day-header h3 {
    color: #ffffff;
    font-size: 1.3rem;
  }

  .agenda-items {
    list-style: none;
  }

  .agenda-item {
    display: flex;
    gap: 2rem;
    padding: 1.5rem 2rem;
    border-left: 4px solid var(--blue);
  }

  .agenda-item + .agenda-item {
    border-top: 1px solid var(--border-light);
  }

  .agenda-item-social,
  .agenda-item-break {
    border-left-color: var(--mint);
    background: rgba(168, 230, 207, 0.08);
  }

  /* Rail and chips carry the coral cue; the row itself stays white so the
     track text holds the foreground. */
  .agenda-item-breakout {
    border-left-color: var(--coral);
  }

  /* Sits between the day header and the first item; its bottom border stands in
     for the .agenda-item + .agenda-item rule the first row never gets. */
  .agenda-day-note {
    padding: 0.85rem 2rem;
    border-left: 4px solid var(--coral);
    border-bottom: 1px solid var(--border-light);
    background: rgba(255, 171, 171, 0.12);
    font-size: 0.92rem;
    color: var(--text-body);
  }

  .agenda-time {
    flex: 0 0 200px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--navy);
  }

  /* Fills the row so detail sub-layouts land at the same width on every item,
     rather than each one sizing to its own longest string. */
  .agenda-content {
    flex: 1;
    min-width: 0;
  }

  .agenda-content h4 {
    font-family: var(--font-body);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--text-heading);
  }

  .agenda-note {
    margin-top: 0.3rem;
    font-size: 0.95rem;
    font-style: italic;
    color: var(--text-muted);
  }

  .agenda-bullets {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 0.7rem;
    list-style: none;
  }

  .agenda-bullets li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.95rem;
  }

  .agenda-bullets li::before {
    content: "";
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--blue);
  }

  .agenda-detail {
    margin-top: 0.9rem;
  }

  .agenda-detail-label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Every row declares the same fixed tracks, so columns line up across rows
     without subgrid or display: contents (which drops list semantics). */
  .presentation-order {
    max-width: 38rem;
    list-style: none;
  }

  .presentation-row {
    display: grid;
    grid-template-columns: 1.5rem 9rem 1fr;
    align-items: baseline;
    column-gap: 1rem;
    padding-block: 0.55rem;
  }

  .presentation-row + .presentation-row {
    border-top: 1px solid var(--border-light);
  }

  .presentation-num {
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    text-align: right;
    padding-right: 0.75rem;
    border-right: 1px solid var(--border-light);
    align-self: stretch;
  }

  .presentation-site {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-heading);
  }

  .presentation-org {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* Same link treatment as the registration notice above. */
  .agenda-jump {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: var(--pink);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .agenda-jump:hover {
    color: var(--pink);
  }

  .breakout-tracks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    list-style: none;
  }

  .breakout-track {
    padding: 1rem 1.15rem 1.15rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-inset);
    background: var(--surface-card);
  }

  .breakout-code {
    display: inline-block;
    margin-bottom: 0.55rem;
    padding: 0.2rem 0.7rem;
    border: 1px solid rgba(255, 171, 171, 0.5);
    border-radius: var(--radius-pill);
    background: rgba(255, 171, 171, 0.22);
    color: var(--navy);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* h5 falls outside the global h1–h4 rule, so it is already Albert Sans. */
  .breakout-title {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-heading);
  }

  .breakout-detail {
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (max-width: 1024px) {
    .agenda-time {
      flex-basis: 160px;
    }
  }

  @media (max-width: 768px) {
    .agenda-item {
      flex-direction: column;
      gap: 0.35rem;
      padding: 1.25rem 1.5rem;
    }

    .agenda-time {
      flex-basis: auto;
      font-size: 0.92rem;
    }

    .agenda-day-header {
      padding: 1.25rem 1.5rem;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .agenda-day-note {
      padding: 0.85rem 1.5rem;
    }

    /* Institution drops to a second line, still aligned under the acronym. */
    .presentation-row {
      grid-template-columns: 1.5rem 1fr;
      row-gap: 0.1rem;
    }

    .presentation-num {
      grid-row: 1 / -1;
    }

    .presentation-org {
      grid-column: 2;
    }

    .breakout-tracks {
      grid-template-columns: 1fr;
    }
  }
</style>
