---
import type { AgendaItem, AgendaPresentation } from "../data/agenda";
import { agenda } from "../data/agenda";
import { presentationFormat } from "../data/presentations";

// Derived from the agenda rather than retyped, so reordering a site in
// agenda.ts updates the Agenda section and these columns together.
const day1 = agenda.find((day) => day.id === "day-1");
const sessions = (day1?.items ?? []).filter(
  (item): item is AgendaItem & { presentations: AgendaPresentation[] } =>
    (item.presentations?.length ?? 0) > 0
);
---

<section id="presentations" class="section section-a">
  <div class="container">
    <div class="reveal">
      <span class="section-tag">Day 1 · General Sessions</span>
      <h2 class="section-title">Site Presentations</h2>
      <p class="section-lead">
        Each site presents for {presentationFormat.duration} across {presentationFormat.slides}.
      </p>
    </div>

    <div class="group reveal">
      <span class="group-label">What every deck covers</span>
      <div class="slide-grid">
        {
          presentationFormat.topics.map((topic, index) => (
            <article class="slide-card">
              <h3 class="slide-topic">{topic.title}</h3>
              {topic.note && <p class="slide-note">{topic.note}</p>}
              <div class="slide-foot">
                <span class="slide-num">{String(index + 1).padStart(2, "0")}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="group reveal">
      <span class="group-label">Who presents when</span>
      <div class="session-grid">
        {
          sessions.map((session) => (
            <article class="session-card">
              <header class="session-head">
                <h3 class="session-name">{session.title}</h3>
                <p class="session-meta">
                  {session.time} · {session.presentations.length} sites
                </p>
              </header>
              <ol class="session-list">
                {session.presentations.map((presentation, index) => (
                  <li class="session-row">
                    <span class="session-num">{index + 1}</span>
                    <span class="session-site">{presentation.site}</span>
                    <span class="session-org">
                      {presentation.org}
                      {presentation.remote && <span class="remote-chip">Remote</span>}
                    </span>
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Cards here deliberately have no hover lift, unlike Overview's and Hotels'.
     This section is reference material people read while cross-checking the
     agenda, so nothing should shift under the cursor. */

  .group {
    margin-top: 2.5rem;
  }

  /* Same micro-label idiom as .agenda-detail-label; Astro scopes per file, so
     it is restated here rather than shared. */
  .group-label {
    display: block;
    margin-bottom: 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .slide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* Proportioned like a slide, with the number sitting bottom-right above a
     footer rule — where a deck puts its page number. The inset radius keeps
     these crisper than the section's larger cards. */
  .slide-card {
    display: flex;
    flex-direction: column;
    aspect-ratio: 16 / 10;
    padding: 1.5rem 1.5rem 1.15rem;
    background: var(--surface-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-inset);
    box-shadow: var(--shadow-card);
  }

  /* Keeps "other U projects" from breaking after the U. */
  .slide-topic {
    font-size: 1.12rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  .slide-note {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .slide-foot {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-light);
  }

  .slide-num {
    font-size: 0.78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  /* start, not stretch — General Session 2 has one fewer site and should end
     where its list ends rather than grow a blank tail to match column 1. */
  .session-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
    gap: 1.5rem;
  }

  /* Blue top rail echoes the blue left rail .agenda-item gives session rows. */
  .session-card {
    padding: 1.75rem 1.75rem 1.25rem;
    background: var(--surface-card);
    border: 1px solid var(--border-light);
    border-top: 3px solid var(--blue);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }

  .session-head {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-light);
  }

  .session-name {
    font-size: 1.25rem;
  }

  .session-meta {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .session-list {
    list-style: none;
  }

  /* Site over institution in a narrow column; the number spans both lines. */
  .session-row {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    column-gap: 0.75rem;
    row-gap: 0.1rem;
    padding-block: 0.7rem;
  }

  .session-row + .session-row {
    border-top: 1px solid var(--border-light);
  }

  .session-num {
    grid-column: 1;
    grid-row: 1 / span 2;
    padding-top: 0.15rem;
    font-size: 0.78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    text-align: right;
  }

  .session-site {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-heading);
  }

  .session-org {
    grid-column: 2;
    grid-row: 2;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  /* Same chip as the agenda's presentation order; restated because Astro
     scopes styles per file. */
  .remote-chip {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid rgba(255, 171, 171, 0.5);
    border-radius: var(--radius-pill);
    background: rgba(255, 171, 171, 0.22);
    color: var(--navy);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .slide-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .session-grid {
      grid-template-columns: 1fr;
    }

    .session-card {
      padding: 1.5rem 1.5rem 1.1rem;
    }
  }

  @media (max-width: 560px) {
    .slide-grid {
      grid-template-columns: 1fr;
    }

    /* A full-width card held to 16:10 would be enormous, so the content sets
       the height once these stack. */
    .slide-card {
      aspect-ratio: auto;
      padding: 1.35rem 1.5rem 1.1rem;
    }

    .slide-foot {
      margin-top: 1.25rem;
    }
  }
</style>
